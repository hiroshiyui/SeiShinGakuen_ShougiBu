[resource]
script = ExtResource("1_bank")
lines = {"start": ["よろしくお願いします！", "さあ、勝負だ！", "全力でいくぜ！", "お手柔らかに頼むよ。"], "check": ["王手だ！", "どうだ、王手！", "逃がさないぞ！", "王手、いただき！"], "lose_piece": ["しまった……！", "くっ、やられた！", "まだまだ、これからだ！", "うわっ、大駒が……！"], "win": ["よっしゃー！", "勝ったぞ！", "いい勝負だった、ありがとうございました！"], "lose": ["くそっ、次は負けないぞ！", "参りました……。", "悔しいけど、勉強になったよ。"]}
